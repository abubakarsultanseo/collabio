# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# SECRET: server-side only. Never add NEXT_PUBLIC_ to this variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Resend API key. SECRET: server-side only.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Collabio <partners@collabio.online>
EMAIL_REPLY_TO=your-existing-inbox@rankviz.com

# Optional: public Google Web OAuth client ID (the same client configured in Supabase).
# Enables the official branded Google account popup. Never paste the Google client secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# App configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backward-compatible alias; NEXT_PUBLIC_SITE_URL takes priority
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Karachi
INVITATION_EXPIRY_HOURS=48
CRON_SECRET=replace-with-a-long-random-secret

# Optional when there is exactly one active admin. Required with multiple admins.
# Set this to Abubakar's Supabase Auth user UUID to assign all direct chats.
CHAT_ADMIN_USER_ID=
